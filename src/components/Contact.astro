---
import { profile } from "../data/portfolio";
---

<section id="contact" class="py-12 border-t border-line text-center">
    <h2 class="text-3xl font-bold mb-4">Discutons ensemble</h2>
    <p class="mb-2 text-muted">{profile.internship.title}.</p>
    <p class="mb-6 text-muted">{profile.extra}</p>
    <div class="flex flex-wrap justify-center gap-4">
        <a href={`mailto:${profile.email}`} class="inline-block px-6 py-3 bg-primary text-on-primary rounded-lg hover:bg-primary-hover transition-colors font-medium">
            M'envoyer un email
        </a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="inline-block px-6 py-3 rounded-lg border border-fg/20 hover:bg-chip transition-colors font-medium">
            Voir mon LinkedIn
        </a>
    </div>
</section>
