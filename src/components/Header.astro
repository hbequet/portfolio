---
import { profile, navItems } from "../data/portfolio";
---

<header class="fixed top-0 left-0 right-0 z-40 h-14 bg-header-bg backdrop-blur-md border-b border-border-header transition-colors">
    <div class="max-w-6xl mx-auto h-full px-5 sm:px-8 flex items-center justify-between">
        <a href="#presentation" class="text-sm font-semibold tracking-tight text-text-main hover:opacity-80 transition-opacity">
            {profile.name}
        </a>

        <div class="flex items-center gap-3 sm:gap-6">
            <nav class="flex items-center gap-3.5 sm:gap-6 text-xs sm:text-sm">
                {navItems.map((item, index) => (
                    <a
                        href={`#${item.id}`}
                        data-target={item.id}
                        class:list={["nav-link", { active: index === 0 }]}
                    >
                        {item.label}
                    </a>
                ))}
            </nav>

            <!-- Bouton bascule de thème clair / sombre -->
            <button
                id="themeToggleBtn"
                type="button"
                aria-label="Basculer entre mode sombre et mode clair"
                title="Basculer entre mode sombre et mode clair"
                class="p-1.5 rounded-md text-text-muted hover:text-text-main hover:bg-surface border border-border-subtle hover:border-border-hover transition-colors cursor-pointer flex items-center justify-center shrink-0"
            >
                <!-- Soleil (affiché en mode sombre pour passer au clair) -->
                <svg class="theme-sun-icon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <!-- Lune (affichée en mode clair pour passer au sombre) -->
                <svg class="theme-moon-icon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>
        </div>
    </div>
</header>
