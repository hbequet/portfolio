---

<div id="modalBackdrop" class="modal-backdrop fixed inset-0 z-50 bg-modal-backdrop backdrop-blur-sm flex items-center justify-center p-3 sm:p-6">
    <div class="modal-window w-[94vw] h-[90vh] max-w-6xl bg-modal-bg border border-border-modal rounded-lg flex flex-col overflow-hidden shadow-2xl">

        <!-- Barre supérieure de la popup -->
        <div class="flex items-center justify-between px-5 sm:px-7 py-4 border-b border-border-subtle bg-modal-header shrink-0">
            <div class="flex items-center gap-3 min-w-0">
                <span id="modalCategory" class="text-xs font-mono text-text-muted">Projet</span>
                <span class="text-text-dim">/</span>
                <h3 id="modalTitle" class="text-sm sm:text-base font-semibold text-text-main truncate">Titre</h3>
            </div>
            <button id="closeModalBtn" type="button" class="px-3 py-1 rounded bg-surface-hover border border-border-modal hover:border-border-modal-hover text-xs text-text-muted hover:text-text-main transition-colors cursor-pointer">
                Fermer (Échap)
            </button>
        </div>

        <!-- Contenu scrollable -->
        <div id="modalContent" class="flex-1 overflow-y-auto inner-scroll p-5 sm:p-8">
            <!-- Injecté dynamiquement en JS -->
        </div>
    </div>
</div>
