---
import { navItems } from "../data/portfolio";
---

<!-- Mini-scrollbar par section sur la droite de l'écran -->
<aside
    id="sectionMiniScrollbar"
    aria-label="Navigation par section"
    class="fixed right-2 sm:right-3.5 top-1/2 -translate-y-1/2 z-40 hidden sm:flex flex-col items-end gap-2.5 py-3 px-1.5 rounded-full bg-surface/50 backdrop-blur-md border border-border-subtle/70 select-none shadow-xl"
>
    {navItems.map((item, index) => (
        <a
            href={`#${item.id}`}
            data-target={item.id}
            class:list={[
                "section-indicator group relative flex items-center justify-end py-0.5 px-0.5 cursor-pointer transition-all",
                { active: index === 0 }
            ]}
            aria-label={`Aller à la section ${item.label}`}
        >
            <!-- Tooltip au survol à gauche du trait -->
            <span class="pointer-events-none absolute right-full mr-3 px-2 py-0.5 rounded bg-surface border border-border-subtle text-[11px] font-mono text-text-light whitespace-nowrap opacity-0 group-hover:opacity-100 transition-all duration-150 shadow-lg translate-x-1 group-hover:translate-x-0">
                {item.label}
            </span>

            <!-- Segment / Trait de la scrollbar -->
            <span class="indicator-bar block w-1 rounded-full transition-all duration-300 bg-text-dim/40 group-hover:bg-text-muted h-5 group-hover:h-7 group-[.active]:h-9 group-[.active]:w-1.5 group-[.active]:bg-text-main group-[.active]:shadow-[0_0_8px_rgba(255,255,255,0.45)]" />
        </a>
    ))}
</aside>
