---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = "Hugo Béquet - Portfolio",
  description = "Portfolio de Hugo Béquet, étudiant en BUT Informatique à Limoges, à la recherche d'un stage de développement fullstack / backend de 16 semaines à partir du 22 février 2027.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          return 'dark';
        }
        return 'light';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
      window.localStorage.setItem('theme', theme);
    </script>
  </head>
  <body class="bg-page text-fg transition-colors duration-300">
  <slot />
  </body>
</html>
